[Unit]
# Managed by Ansible.
Description=UPS cascade orchestrator
Documentation=file://{{ ups_cascade_lib_dir }}/README.md
After=network-online.target nut-server.service nut-monitor.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile={{ ups_cascade_etc_dir }}/ups-cascade.env
ExecStart={{ ups_cascade_lib_dir }}/ups_cascade.py monitor
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

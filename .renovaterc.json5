{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    ":timezone(Europe/Warsaw)",

    "local>deedee/mark13//.renovate/homeOpsBase.json5",
    "local>deedee/mark13//.renovate/homeOpsApps.json5",

    "local>deedee/mark13//.renovate/autoMerge.json5",
    "local>deedee/mark13//.renovate/customManagers.json5",
    "local>deedee/mark13//.renovate/exclusions.json5",
    "local>deedee/mark13//.renovate/groups.json5",
    "local>deedee/mark13//.renovate/labels.json5",
    "local>deedee/mark13//.renovate/talosFactory.json5",
  ],
  packageRules: [
    {
      description: "Map terraform registry to opentofu",
      matchDatasources: ["terraform-provider", "terraform-module"],
      registryUrls: ["https://registry.opentofu.org"],
    },
  ],
}
